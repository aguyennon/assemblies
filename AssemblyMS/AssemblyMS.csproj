<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- .NET 8 = current long-term-support release -->
    <TargetFramework>net8.0</TargetFramework>

    <!-- Enables modern C#: 'string?' nullability + implicit 'using' lines.
         Keeps files short and surfaces null-related bugs at compile time. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- CRITICAL: the Access ACE/OLEDB driver is 64-bit on your host, so the app
         MUST also run 64-bit. Forcing x64 here prevents the classic
         "provider is not registered on the local machine" error that happens
         when a 32-bit app tries to load a 64-bit driver (or vice versa). -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Talks to SQL Server at 10.0.7.2 (the BatchNO lookup) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />

    <!-- Talks to the Access .mdb file via OLEDB (the cut list).
         System.Data.OleDb is Windows-only, which is fine — your host is Windows. -->
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
  </ItemGroup>

</Project>